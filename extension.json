{
	"name": "AGGrid",
	"version": "0.3.0",
	"author": [
		"alistair3149"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:AGGrid",
	"descriptionmsg": "aggrid-desc",
	"type": "other",
	"license-name": "GPL-3.0-or-later",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"extensions": {
			"Scribunto": "*"
		}
	},
	"MessagesDirs": {
		"AGGrid": [
			"i18n"
		]
	},
	"TrackingCategories": [
		"aggrid-tracking-category"
	],
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\AGGrid\\": "includes/"
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"Hooks": {
		"ScribuntoExternalLibraries": "scribunto",
		"LoadExtensionSchemaUpdates": "schema",
		"LinksUpdateComplete": "linksupdate",
		"PageDeleteComplete": "pagedelete"
	},
	"HookHandlers": {
		"scribunto": {
			"class": "MediaWiki\\Extension\\AGGrid\\Hooks\\ScribuntoHandler"
		},
		"schema": {
			"class": "MediaWiki\\Extension\\AGGrid\\Hooks\\SchemaHandler"
		},
		"linksupdate": {
			"class": "MediaWiki\\Extension\\AGGrid\\Hooks\\LinksUpdateHandler",
			"services": [
				"AGGrid.InlineDataStore",
				"AGGrid.SourceSpecStore"
			]
		},
		"pagedelete": {
			"class": "MediaWiki\\Extension\\AGGrid\\Hooks\\PageDeleteHandler",
			"services": [
				"AGGrid.InlineDataStore",
				"AGGrid.SourceSpecStore"
			]
		}
	},
	"RestRoutes": [
		{
			"path": "/aggrid/v0/grid/{pageid}/{rev}/{index}/rows",
			"method": "GET",
			"class": "MediaWiki\\Extension\\AGGrid\\Rest\\GridRowsHandler",
			"services": [
				"AGGrid.InlineDataStore",
				"PermissionManager",
				"TitleFactory",
				"UserFactory"
			]
		},
		{
			"path": "/aggrid/v0/grid/{pageid}/{rev}/{index}/page",
			"method": "GET",
			"class": "MediaWiki\\Extension\\AGGrid\\Rest\\GridPageHandler",
			"services": [
				"AGGrid.BackendRegistry",
				"AGGrid.SourceSpecStore",
				"PermissionManager",
				"TitleFactory",
				"UserFactory"
			]
		},
		{
			"path": "/aggrid/v0/grid/{pageid}/{rev}/{index}/values",
			"method": "GET",
			"class": "MediaWiki\\Extension\\AGGrid\\Rest\\GridValuesHandler",
			"services": [
				"AGGrid.BackendRegistry",
				"AGGrid.SourceSpecStore",
				"PermissionManager",
				"TitleFactory",
				"UserFactory"
			]
		}
	],
	"ResourceModules": {
		"ext.aggrid.styles": {
			"styles": [
				"ext.aggrid/ext.aggrid.less"
			]
		},
		"ext.aggrid": {
			"packageFiles": [
				"ext.aggrid/init.js",
				"ext.aggrid/mountGrid.js",
				"ext.aggrid/theme.js",
				"ext.aggrid/lazyMount.js",
				"ext.aggrid/renderers.js",
				"ext.aggrid/registry.js",
				"ext.aggrid/format.js",
				"ext.aggrid/setFilter.js",
				"ext.aggrid/quickSearch.js"
			],
			"dependencies": [
				"mediawiki.api"
			],
			"messages": [
				"aggrid-error-load",
				"aggrid-setfilter-search-placeholder",
				"aggrid-setfilter-select-all",
				"aggrid-setfilter-blanks",
				"aggrid-setfilter-loading",
				"aggrid-setfilter-partial",
				"aggrid-setfilter-values-error",
				"aggrid-quicksearch-placeholder",
				"aggrid-quicksearch-label"
			]
		}
	},
	"config": {
		"AGGridBackendCacheMaxAge": {
			"value": 120,
			"description": "Max-age (seconds) for backend-source grid REST responses (cursor pages and column values)."
		},
		"AGGridBucketMaxValues": {
			"value": 1000,
			"description": "Maximum number of rows scanned when listing a Bucket column's set-filter values; the list is marked partial when reached."
		}
	},
	"ForeignResourcesDir": "modules/lib",
	"ResourceFileModulePaths": {
		"localBasePath": "modules",
		"remoteExtPath": "AGGrid/modules"
	},
	"manifest_version": 2
}
