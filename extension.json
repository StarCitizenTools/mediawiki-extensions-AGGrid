{
	"name": "AGGrid",
	"version": "0.6.0",
	"author": [
		"alistair3149"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:AGGrid",
	"descriptionmsg": "aggrid-desc",
	"type": "other",
	"license-name": "GPL-3.0-or-later",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"extensions": {
			"Scribunto": "*"
		}
	},
	"MessagesDirs": {
		"AGGrid": [
			"i18n"
		]
	},
	"TrackingCategories": [
		"aggrid-tracking-category"
	],
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\AGGrid\\": "includes/"
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"Hooks": {
		"ScribuntoExternalLibraries": "scribunto",
		"LoadExtensionSchemaUpdates": "schema",
		"LinksUpdateComplete": "linksupdate",
		"PageDeleteComplete": "pagedelete"
	},
	"HookHandlers": {
		"scribunto": {
			"class": "MediaWiki\\Extension\\AGGrid\\Hooks\\ScribuntoHandler"
		},
		"schema": {
			"class": "MediaWiki\\Extension\\AGGrid\\Hooks\\SchemaHandler"
		},
		"linksupdate": {
			"class": "MediaWiki\\Extension\\AGGrid\\Hooks\\LinksUpdateHandler",
			"services": [
				"AGGrid.InlineDataStore",
				"AGGrid.SourceSpecStore"
			]
		},
		"pagedelete": {
			"class": "MediaWiki\\Extension\\AGGrid\\Hooks\\PageDeleteHandler",
			"services": [
				"AGGrid.InlineDataStore",
				"AGGrid.SourceSpecStore"
			]
		}
	},
	"RestRoutes": [
		{
			"path": "/aggrid/v0/grid/{pageid}/{token}/{index}/rows",
			"method": "GET",
			"class": "MediaWiki\\Extension\\AGGrid\\Rest\\GridRowsHandler",
			"services": [
				"AGGrid.InlineDataStore",
				"PermissionManager",
				"TitleFactory",
				"UserFactory",
				"AGGrid.GridDataPopulator",
				"AGGrid.CachePolicyResolver"
			]
		},
		{
			"path": "/aggrid/v0/grid/{pageid}/{token}/{index}/page",
			"method": "GET",
			"class": "MediaWiki\\Extension\\AGGrid\\Rest\\GridPageHandler",
			"services": [
				"AGGrid.BackendRegistry",
				"AGGrid.SourceSpecStore",
				"PermissionManager",
				"TitleFactory",
				"UserFactory",
				"AGGrid.GridDataPopulator"
			]
		},
		{
			"path": "/aggrid/v0/grid/{pageid}/{token}/{index}/values",
			"method": "GET",
			"class": "MediaWiki\\Extension\\AGGrid\\Rest\\GridValuesHandler",
			"services": [
				"AGGrid.BackendRegistry",
				"AGGrid.SourceSpecStore",
				"PermissionManager",
				"TitleFactory",
				"UserFactory",
				"AGGrid.GridDataPopulator"
			]
		}
	],
	"ResourceModules": {
		"ext.aggrid.styles": {
			"styles": [
				"ext.aggrid/ext.aggrid.less"
			]
		},
		"ext.aggrid": {
			"packageFiles": [
				"ext.aggrid/init.js",
				"ext.aggrid/mountGrid.js",
				"ext.aggrid/theme.js",
				"ext.aggrid/lazyMount.js",
				"ext.aggrid/renderers.js",
				"ext.aggrid/registry.js",
				"ext.aggrid/format.js",
				"ext.aggrid/setFilter.js",
				"ext.aggrid/quickSearch.js",
				"ext.aggrid/toolbar.js",
				"ext.aggrid/expand.js",
				{
					"name": "ext.aggrid/bundle.json",
					"callback": "MediaWiki\\Extension\\AGGrid\\ResourceLoader\\Bundle::makePackageFile",
					"versionCallback": "MediaWiki\\Extension\\AGGrid\\ResourceLoader\\Bundle::getVersionFilePath"
				}
			],
			"dependencies": [
				"mediawiki.api",
				"mediawiki.page.ready"
			],
			"messages": [
				"aggrid-error-load",
				"aggrid-setfilter-search-placeholder",
				"aggrid-setfilter-select-all",
				"aggrid-setfilter-blanks",
				"aggrid-setfilter-loading",
				"aggrid-setfilter-partial",
				"aggrid-setfilter-values-error",
				"aggrid-quicksearch-placeholder",
				"aggrid-quicksearch-label",
				"aggrid-expand-label",
				"aggrid-expand-collapse-label",
				"aggrid-expand-dialog-label"
			]
		}
	},
	"config": {
		"AGGridCacheControl": {
			"value": {
				"inline": {
					"maxAge": 86400,
					"staleWhileRevalidate": 604800
				},
				"default": {
					"maxAge": 600
				}
			},
			"merge_strategy": "array_plus_2d",
			"description": "Per-source cache policy for grid REST responses, keyed by source. 'inline' is the materialized /rows path (content-addressed: the URL changes when rows change, so maxAge is a revalidation cadence, not a staleness ceiling). 'default' is the fallback for backend sources: maxAge bounds how stale the live query data may be (no purge when the queried data changes), but a change to the grid's query spec propagates instantly because the backend URL is content-addressed by the spec hash. Add a backend source id (e.g. 'smw', 'bucket') to override it. Each entry: { maxAge: seconds, staleWhileRevalidate?: seconds }."
		},
		"AGGridBucketMaxValues": {
			"value": 1000,
			"description": "Maximum number of rows scanned when listing a Bucket column's set-filter values; the list is marked partial when reached."
		}
	},
	"ForeignResourcesDir": "modules/lib",
	"ResourceFileModulePaths": {
		"localBasePath": "modules",
		"remoteExtPath": "AGGrid/modules"
	},
	"manifest_version": 2
}
