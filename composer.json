{
	"name": "starcitizentools/ag-grid",
	"type": "mediawiki-extension",
	"description": "Renders AG Grid data grids in MediaWiki",
	"keywords": [
		"MediaWiki",
		"AGGrid",
		"AG Grid",
		"extension"
	],
	"homepage": "https://www.mediawiki.org/wiki/Extension:AGGrid",
	"readme": "README.md",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "alistair3149",
			"email": "alistair31494322@gmail.com",
			"role": "Developer"
		}
	],
	"support": {
		"forum": "https://www.mediawiki.org/wiki/Extension_talk:AGGrid",
		"wiki": "https://www.mediawiki.org/wiki/Extension:AGGrid",
		"source": "https://github.com/StarCitizenTools/mediawiki-extensions-AGGrid"
	},
	"require": {
		"composer/installers": ">=1.0.1"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "52.0.1",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"scripts": {
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"test": [
			"parallel-lint . --exclude node_modules --exclude vendor",
			"@phpcs",
			"minus-x check ."
		],
		"phan": "phan -d . --long-progress-bar",
		"phpcs": [
			"phpcs --config-set ignore_warnings_on_exit 1",
			"phpcs -sp --cache"
		],
		"phpunit": "cd ../../ && composer phpunit -- extensions/AGGrid/tests/phpunit/",
		"preflight": [
			"@test",
			"@phan",
			"@phpunit"
		]
	},
	"extra": {
		"installer-name": "AGGrid"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
